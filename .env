# Pick ONE provider and set its key. If LLM_PROVIDER is omitted it is chosen from whichever key is set.

# --- Option A: Google Gemini ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_key_here
LLM_MODEL= gemini-flash-lite-latest

# --- Option B: Anthropic Claude ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-key-here
# LLM_MODEL=claude-sonnet-5-5

# Retrieval tuning (cosine distance, lower = stricter)
# MEMORY_MAX_DISTANCE=0.70
# DOC_MAX_DISTANCE=0.75
